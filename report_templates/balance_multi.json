{
  "id": "balance_multi",
  "name": "资产负债表（多级表头）",
  "description": "需上传包含下列字段的 Excel：日期、流动资产、固定资产、短期借款、应付账款",
  "target_ccy": "CNY",
  "amount_columns": ["流动资产", "固定资产", "短期借款", "应付账款"],
  "currency_columns": {
    "流动资产": {"from": "CNY", "to": "CNY"},
    "固定资产": {"from": "CNY", "to": "CNY"}
  },
  "thead": [
    [
      {"text": "日期", "rowspan": 2},
      {"text": "资产（折算 CNY）", "colspan": 2},
      {"text": "负债（折算 CNY）", "colspan": 2}
    ],
    [
      {"text": "流动资产"},
      {"text": "固定资产"},
      {"text": "短期借款"},
      {"text": "应付账款"}
    ]
  ],
  "column_order": ["日期", "流动资产", "固定资产", "短期借款", "应付账款"],
  "embedded_rows": [
